# Local: gerado por `npm run setup` / `npm run db:env`
# Nuvem: use Project Settings > API Keys do projeto no supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor (Route Handlers / Server Actions). Ignora RLS — nunca prefixe
# com NEXT_PUBLIC_, ou ela vai parar no bundle do browser.
SUPABASE_SECRET_KEY=

# Cotação (opcional)
# Fallback brapi.dev — sem token, só ticker único e rate limit baixo.
BRAPI_TOKEN=
# Ordem da cadeia de providers; inverta para testar o fallback.
QUOTE_PROVIDER_ORDER=yahoo,brapi
# Idade máxima da cotação antes de buscar de novo.
QUOTE_STALE_MINUTES=15
